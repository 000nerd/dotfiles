#!/usr/bin/env bash

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1
SUB_COMMAND_NAME=$2

ARROW="￫"
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

# Get dotfiles dir (so run this script from anywhere)
export DOTFILES_DIR EXTRA_DIR
DOTFILES_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && cd .. && pwd )"

sub_help () {
    echo -e "$ARROW Usage: ${YELLOW}$BIN_NAME <command>${NC}"
    echo
    echo "Commands:"
    echo "   help             This help message"
    echo "   update           Update packages and pkg managers"
    echo "   clean            Clean up caches"
    echo "   doctor           Check dotfiles health"
    echo "   install          Run installer; passes through installer options"
    echo "   backup           Run backup script"
    echo "   symlinks         Run symlinks script"
    echo "   brew             Run brew script"
    echo "   macos            Run MacOS defaults script"
    echo "   java             Run java script"
    echo "   javascript       Run javascript script"
    echo "   python           Run python script"
}

sub_update () {
    # Update App Store apps
    sudo softwareupdate -i -a
    # Update Homebrew (Cask) & packages
    brew upgrade --greedy
    # Update node & npm & packages
    nvm install --lts # install last lts node instance
    npm install npm -g
    # Update Conda
    # conda env update
    # conda update --all
    # conda upgrade conda
    # conda upgrade anaconda
    echo -e "${GREEN}$ARROW Success! Update command finished.${NC}"
}

sub_clean () {
    brew cleanup
    npm cache clean --force
    echo -e "${GREEN}$ARROW Success! Clean command finished.${NC}"
}

sub_backup () {
    source "$DOTFILES_DIR/install/backup.sh"
    echo -e "${GREEN}$ARROW Success! Backup command finished.${NC}"
}

sub_symlinks () {
    source "$DOTFILES_DIR/install/symlinks.sh"
    echo -e "${GREEN}$ARROW Success! Symlinks command finished.${NC}"
}

sub_brew () {
    case "$(uname)" in
        Darwin) source "$DOTFILES_DIR/install/mac/brew.sh" ;;
        Linux) source "$DOTFILES_DIR/install/linux/brew.sh" ;;
        *) echo -e "${RED}$ARROW Brew install is not configured for $(uname).${NC}" >&2; return 1 ;;
    esac
    echo -e "${GREEN}$ARROW Success! Brew command finished.${NC}"
}

sub_macos () {
    source "$DOTFILES_DIR/install/mac/macos.sh"
    echo -e "${GREEN}$ARROW Success! MacOS defaults command finished.${NC}"
}

sub_defaults () {
    sub_macos "$@"
}

sub_dock () {
    echo -e "${YELLOW}$ARROW Dock setup script does not exist yet.${NC}" >&2
    return 1
}

sub_java () {
    source "$DOTFILES_DIR/install/lang/java.sh"
    echo -e "${GREEN}$ARROW Success! Java command finished.${NC}"
}

sub_javascript () {
    source "$DOTFILES_DIR/install/lang/javascript.sh"
    echo -e "${GREEN}$ARROW Success! Javascript command finished.${NC}"
}

sub_python () {
    source "$DOTFILES_DIR/install/lang/python.sh"
    echo -e "${GREEN}$ARROW Success! Python command finished.${NC}"
}

sub_install () {
    "$DOTFILES_DIR/install.sh" "$@"
}

sub_doctor () {
    local ok=true

    echo -e "$ARROW Checking dotfiles setup"

    for dir in "$DOTFILES_DIR" "$DOTFILES_DIR/install" "$DOTFILES_DIR/zsh" "$DOTFILES_DIR/bin" "$DOTFILES_DIR/bins"; do
        if [ -d "$dir" ]; then
            echo -e "${GREEN}ok${NC} $dir"
        else
            echo -e "${RED}missing${NC} $dir"
            ok=false
        fi
    done

    for cmd in git zsh; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo -e "${GREEN}ok${NC} $cmd"
        else
            echo -e "${RED}missing${NC} $cmd"
            ok=false
        fi
    done

    if command -v brew >/dev/null 2>&1; then
        echo -e "${GREEN}ok${NC} brew $(brew --version | head -n 1)"
    else
        echo -e "${YELLOW}warn${NC} brew not found"
    fi

    for link in "$HOME/.zshrc" "$HOME/.gitconfig" "$HOME/.gitignore_global"; do
        if [ -L "$link" ]; then
            echo -e "${GREEN}ok${NC} $link -> $(readlink "$link")"
        elif [ -e "$link" ]; then
            echo -e "${YELLOW}warn${NC} $link exists but is not a symlink"
        else
            echo -e "${YELLOW}warn${NC} $link is not installed"
        fi
    done

    [ "$ok" = true ]
}

case $COMMAND_NAME in
    "" | "-h" | "--help")
        sub_help
        ;;
    *)
        shift
        sub_${COMMAND_NAME} $@
        if [ $? = 127 ]; then
            echo -e "${RED}$ARROW Error: '$COMMAND_NAME' is not a known command or has errors.${NC}" >&2
            sub_help
            exit 1
        fi
        ;;
esac
