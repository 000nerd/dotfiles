# Personal bootstrap defaults.
#
# CLI flags win over these values, so this can stay opinionated while still
# letting you run one-off slices like:
#   ./install.sh --profile personal --only symlinks

: "${DOTFILES_ONLY_STEPS:=}"
: "${DOTFILES_SKIP_STEPS:=}"

# Set this to avoid the macOS computer-name prompt on a fresh machine.
# : "${DOTFILES_COMPUTER_NAME:=iObsa Mac}"
: "${DOTFILES_HOST_NAME:=iObsa}"
