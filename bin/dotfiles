    sub_run_help "javascript" "Install the JavaScript and Node development environment."
}

sub_javascript () {
    require_run javascript "$@" || return $?
    [ "$RUN_REQUESTED" = true ] || return 0
    source "$DOTFILES_DIR/install/languages/javascript.sh"
    echo -e "${GREEN}$ARROW Success! Javascript command finished.${NC}"
}

sub_python_help () {
    sub_run_help "python" "Install the Python development environment and Python CLI tools."
}

sub_python () {
    require_run python "$@" || return $?
    [ "$RUN_REQUESTED" = true ] || return 0
    source "$DOTFILES_DIR/install/languages/python.sh"
    echo -e "${GREEN}$ARROW Success! Python command finished.${NC}"
}

sub_install_help () {
    "$DOTFILES_DIR/install.sh" --help
}

sub_install () {
    case "${1:-}" in
        "" | "-h" | "--help" | "help")
            sub_install_help
            return 0
            ;;
    esac
    "$DOTFILES_DIR/install.sh" "$@"
}

sub_doctor_help () {
    sub_run_help "doctor" "Check dotfiles health, expected directories, tools, and installed symlinks."
}

sub_doctor () {
    require_run doctor "$@" || return $?
    [ "$RUN_REQUESTED" = true ] || return 0
    local ok=true

    echo -e "$ARROW Checking dotfiles setup"

    for dir in "$DOTFILES_DIR" "$DOTFILES_DIR/install" "$DOTFILES_DIR/config/zsh" "$DOTFILES_DIR/bin"; do
        if [ -d "$dir" ]; then
            echo -e "${GREEN}ok${NC} $dir"
        else
            echo -e "${RED}missing${NC} $dir"
            ok=false
        fi
    done

    for cmd in git zsh; do
        if command -v "$cmd" >/dev/null 2>&1; then
            echo -e "${GREEN}ok${NC} $cmd"
        else
            echo -e "${RED}missing${NC} $cmd"
            ok=false
        fi
    done

    if command -v brew >/dev/null 2>&1; then
        echo -e "${GREEN}ok${NC} brew $(brew --version | head -n 1)"
    else
        echo -e "${YELLOW}warn${NC} brew not found"
    fi

    source "$DOTFILES_DIR/install/links.sh"
    doctor_link() {
        local source="$1" link="$2"
        if [ -L "$link" ] && [ -e "$link" ] && [ "$(readlink "$link")" = "$source" ]; then
            echo -e "${GREEN}ok${NC} $link -> $source"
        else
            echo -e "${RED}invalid${NC} $link (expected link to $source)"
            ok=false
        fi
    }
    dotfiles_each_link doctor_link || return $?

    [ "$ok" = true ]
}

sub_editors_help () {
    python3 "$DOTFILES_DIR/scripts/editors.py" --help
}

sub_editors () {
    case "${1:-}" in
        "" | "-h" | "--help" | "help") sub_editors_help ;;
        *) python3 "$DOTFILES_DIR/scripts/editors.py" "$@" ;;
    esac
}

sub_theme () {
    case "${1:-}" in
        "" | "-h" | "--help" | "help")
            python3 "$DOTFILES_DIR/scripts/theme.py" --help
            return 0
            ;;
    esac
    python3 "$DOTFILES_DIR/scripts/theme.py" "$@"
}

case $COMMAND_NAME in
    "" | "-h" | "--help")
        sub_help
        ;;
    "help")
        if [ -n "${2:-}" ] && declare -F "sub_${2}_help" >/dev/null 2>&1; then
            "sub_${2}_help"
        else
            sub_help
        fi
        ;;
    *)
        shift
        if declare -F "sub_${COMMAND_NAME}" >/dev/null 2>&1; then
            "sub_${COMMAND_NAME}" "$@"
        else
            echo -e "${RED}$ARROW Error: '$COMMAND_NAME' is not a known command or has errors.${NC}" >&2
            sub_help
            exit 1
        fi
        ;;
esac
